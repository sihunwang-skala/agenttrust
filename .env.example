# Copy to .env for local use. Never commit .env. No real credentials are needed for the demo.
AGENTTRUST_DATABASE_URL=sqlite:///./data/agenttrust.db
AGENTTRUST_KEY_DIR=./data/keys
AGENTTRUST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AGENTTRUST_DUPLICATE_WINDOW_SECONDS=30
# Enables POST /api/v1/demo/reset (wipes all demo data). Local demo only.
AGENTTRUST_ALLOW_DEMO_RESET=false
